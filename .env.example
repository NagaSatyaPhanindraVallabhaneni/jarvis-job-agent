# ══════════════════════════════════════════════════════════════
#  Jarvis Job Agent — Environment Configuration
# ══════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your values.
#  Only HF_TOKEN is needed for full Muse Glimmer 30B power.
# ══════════════════════════════════════════════════════════════

# ── PRIMARY AI ENGINE: Meta Muse Glimmer 30B (Apache 2.0, FREE) ──────────────
# HuggingFace Serverless Inference — runs on HF's cloud GPUs, no local GPU needed.
# Steps to get your free token:
#   1. Go to https://huggingface.co/settings/tokens
#   2. Click "New token" → name it "jarvis" → Role: "Read" → Create
#   3. Copy the token (starts with hf_) and paste below
HF_TOKEN=hf_your_token_here

# Optional overrides (defaults work out of the box)
# HF_MODEL=meta-models/Muse-Glimmer-30B
# HF_TIMEOUT_SECONDS=45

# ── FALLBACK AI ENGINE: OpenRouter Free Tier ─────────────────────────────────
# Automatic fallback if Muse Glimmer is rate-limited or timing out.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free

# ── CANDIDATE & SYSTEM SETTINGS ───────────────────────────────────────────────
# These are pre-configured in config.py — only override if needed.
# CANDIDATE_EMAIL=phanindra.vns@gmail.com
# CANDIDATE_PHONE=+1 (984) 687-6001
# HEADLESS=false
# DRY_RUN=false
# MAX_JOBS_PER_CYCLE=5
# CYCLE_INTERVAL_SECONDS=45
# JOB_FRESHNESS_WINDOW_HOURS=24   # allowed: 6, 24, 48
# SCAN_ALL_COMPANIES_EACH_CYCLE=true
